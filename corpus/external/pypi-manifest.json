  "_template_removal": {
    "why": "PyPI project pages carry their download table, per-file hashes, attestations and release history inside the main content area, so a single-page extractor keeps them. They were 90.9% of this corpus, and IDF is computed over that text.",
    "how": "scrape/boilerplate.py: a heading present in at least half the documents from one host is that host's template; its section is dropped down to the next heading of the same or a higher level.",
    "headings_removed": [
      "built distribution",
      "download files",
      "file details",
      "file hashes",
      "file metadata",
      "provenance",
      "release history release notifications |",
      "source distribution"
