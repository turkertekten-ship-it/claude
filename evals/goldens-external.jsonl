# External golden set: PyPI project pages (corpus/external/pypi).
#
# Why this exists separately from goldens.jsonl: the primary corpus is this
# repository, which documents its own evaluation. Golden questions therefore
# leak into it, get quarantined, and the eval measures a progressively smaller
# corpus. This corpus has no relationship to the repository and cannot contain
# the questions asked of it - so contamination here should be clean, and if it
# is not, that is a real finding rather than a self-reference artefact.
#
# Every expectation below was verified against the fetched text before it was
# written; see corpus/external/pypi-manifest.json for provenance.
{"question": "Which library provides Mozilla's curated collection of root certificates?", "expect_sources": ["certifi"], "expect_answer_contains": ["Mozilla"], "tags": ["external", "tls"]}
{"question": "What does the Command Line Interface Creation Kit do?", "expect_sources": ["click"], "tags": ["external", "cli"]}
{"question": "Which package implements PEP 440 version handling for Python packaging?", "expect_sources": ["packaging"], "tags": ["external", "packaging"]}
{"question": "Which library smooths over differences between Python 2 and Python 3?", "expect_sources": ["six"], "tags": ["external", "compatibility"]}
{"question": "What handles internationalized domain names in applications?", "expect_sources": ["idna"], "tags": ["external", "encoding"]}
{"question": "Which package offers connection pooling and thread safety for HTTP?", "expect_sources": ["urllib3", "requests"], "tags": ["external", "http"]}
{"question": "What is relativedelta used for?", "expect_sources": ["python-dateutil"], "tags": ["external", "datetime"]}
{"question": "Which library renders tables, progress bars and syntax highlighting in the terminal?", "expect_sources": ["rich"], "tags": ["external", "terminal"]}
{"question": "Which package relieves you from writing dunder methods by hand?", "expect_sources": ["attrs"], "tags": ["external", "classes"]}
{"question": "Which testing framework is built around fixtures?", "expect_sources": ["pytest"], "tags": ["external", "testing"]}
{"question": "What does IDNA 2008 support mean for domain name encoding?", "expect_sources": ["idna"], "tags": ["external", "encoding"]}
{"question": "Which library detects the character encoding of a byte sequence?", "expect_sources": ["charset-normalizer"], "tags": ["external", "encoding"]}
{"question": "What is used to escape strings safely for HTML templates?", "expect_sources": ["markupsafe"], "tags": ["external", "templating"]}
{"question": "Which package parses and emits YAML in Python?", "expect_sources": ["pyyaml"], "tags": ["external", "serialization"]}
{"question": "Which HTTP library describes itself as elegant and simple for humans?", "expect_sources": ["requests"], "tags": ["external", "http"]}
{"question": "Which project is trusted by NASA for Mars missions?", "expect_sources": ["attrs"], "expect_answer_contains": ["Mars"], "tags": ["external", "distinctive"]}
{"question": "What is the boiling point of mercury?", "expect_abstain": true, "tags": ["external", "negative"]}
{"question": "Who won the 1998 FIFA World Cup final?", "expect_abstain": true, "tags": ["external", "negative"]}
{"question": "What is the capital of France?", "expect_abstain": true, "tags": ["external", "negative"]}
{"question": "How should I season a cast iron skillet?", "expect_abstain": true, "tags": ["external", "negative"]}
# --- Harder cases, added once the first set reached ceiling. A regression gate
# at 20/20 with recall 1.00 cannot detect a regression; these restore headroom.
# Four kinds: semantic gap (question and answer share little vocabulary),
# multi-source, disambiguation between similar packages, and near-miss negatives
# that are plausible in this domain but genuinely absent from the corpus.
{"question": "How do I stop a token being tampered with in transit?", "expect_sources": ["itsdangerous"], "tags": ["external", "semantic-gap"]}
{"question": "What lets me change a database schema over time without losing data?", "expect_sources": ["alembic"], "tags": ["external", "semantic-gap"]}
{"question": "Which library provides the WSGI utilities that Flask is built on?", "expect_sources": ["werkzeug"], "tags": ["external", "positive", "revised"], "notes": "Replaces 'How do Python programs talk to a web server?', which was written for a 33-document corpus where werkzeug and flask were the only plausible answers. At 91 documents, ten of them answer it - httpx, requests, urllib3, aiohttp, h11, uvicorn, starlette, gunicorn, flask, werkzeug - and it is ambiguous between the client and the server side, so it can no longer discriminate. The replacement is taken from werkzeug's own first line: 'a comprehensive WSGI web application library'. Recorded rather than quietly widened: a question that ten documents answer is not a retrieval test."}
{"question": "What keeps two processes from writing the same file at once?", "tags": ["external", "negative"], "expect_abstain": true, "notes": "filelock's PyPI page was a stub - badges and download links - and was dropped from the corpus when the thinness check was moved to run on the stored text rather than the fetched text. The corpus now has nothing on file locking at all, so abstention is unambiguously correct; it was already the assertion when the stub was present."}
{"question": "How does one Python library let other packages hook into it?", "expect_sources": ["pluggy"], "tags": ["external", "semantic-gap"]}
{"question": "What runs my tests against several Python versions in clean environments?", "expect_sources": ["tox", "virtualenv"], "tags": ["external", "multi-source"]}
{"question": "How can Python call into existing C code?", "expect_sources": ["cffi", "pycparser"], "tags": ["external", "multi-source"]}
{"question": "Which package reads TOML configuration files?", "expect_sources": ["tomli"], "tags": ["external", "config"]}
{"question": "What measures which lines of my code the tests actually execute?", "expect_sources": ["coverage"], "tags": ["external", "semantic-gap"]}
{"question": "Which library dispatches in-process notifications between objects?", "expect_sources": ["blinker"], "tags": ["external", "semantic-gap"]}
{"question": "Where should an application store its config and cache directories?", "expect_sources": ["platformdirs"], "tags": ["external", "semantic-gap"]}
{"question": "What is the difference between the ORM and the migrations tool by the same author?", "expect_sources": ["sqlalchemy", "alembic"], "tags": ["external", "multi-source", "disambiguation"]}
{"question": "Which package provides the WSGI utilities that Flask builds on?", "expect_sources": ["werkzeug"], "tags": ["external", "disambiguation"]}
{"question": "Which library pins dependency hashes for reproducible installs?", "expect_abstain": true, "tags": ["external", "negative", "near-miss"]}
{"question": "Which tool publishes a package to a private PyPI mirror?", "expect_abstain": true, "tags": ["external", "negative", "near-miss"]}
{"question": "Which package renders Jinja templates to PDF?", "expect_abstain": true, "tags": ["external", "negative", "near-miss"]}
{"question": "Which library detects which async framework the calling code is running under?", "expect_sources": ["sniffio"], "tags": ["external", "positive"]}
{"question": "Which library implements HTTP/1.1 but performs no I/O of its own?", "expect_sources": ["h11"], "tags": ["external", "positive"]}
{"question": "Which package reports when a file is created or modified on disk?", "expect_sources": ["watchdog"], "tags": ["external", "positive"]}
{"question": "How can a test control what the clock returns?", "expect_sources": ["freezegun"], "tags": ["external", "positive"]}
{"question": "Which library fakes HTTP replies so tests make no real network calls?", "expect_sources": ["responses"], "tags": ["external", "positive"]}
{"question": "Which logging library treats every event as a dictionary passed through a chain of functions?", "expect_sources": ["structlog"], "tags": ["external", "positive"]}
{"question": "Which package represents graphs and studies their structure?", "expect_sources": ["networkx"], "tags": ["external", "positive"]}
{"question": "Which JSON library serialises dataclasses, datetimes and UUIDs without extra code?", "expect_sources": ["orjson"], "tags": ["external", "positive"]}
{"question": "Which format exchanges data between languages as compact binary rather than text?", "expect_sources": ["msgpack"], "tags": ["external", "positive"]}
{"question": "Which library implements RFC 7519 tokens?", "expect_sources": ["pyjwt"], "tags": ["external", "positive"]}
{"question": "How should a password be stored so the stored form cannot be reversed?", "expect_sources": ["bcrypt"], "tags": ["external", "positive"]}
{"question": "How can a program check that a document matches a declared schema?", "expect_sources": ["jsonschema"], "tags": ["external", "positive"]}
{"question": "Which library converts objects to and from native Python types without assuming an ORM?", "expect_sources": ["marshmallow"], "tags": ["external", "positive"]}
{"question": "Which library offers a friendlier replacement for handling dates and times?", "expect_sources": ["arrow"], "tags": ["external", "positive"]}
{"question": "Which server runs an ASGI application?", "expect_sources": ["uvicorn"], "tags": ["external", "positive"]}
{"question": "Which package sends mail over SMTP?", "expect_abstain": true, "tags": ["external", "negative", "near-miss"], "notes": "Verified absent: 'smtp' matches 0 of 91 documents. 'email' matches 8, so the near-miss is real."}
{"question": "Which library trains a convolutional neural network?", "expect_abstain": true, "tags": ["external", "negative", "near-miss"], "notes": "Verified absent: 'convolutional' matches 0 documents. 'network' is present in networkx, which is the near-miss."}
{"question": "Which package reads and writes spreadsheet files?", "expect_abstain": true, "tags": ["external", "negative", "near-miss"], "notes": "Verified absent: 'spreadsheet' matches 0 documents; 'excel' matches 7 (pandas and friends mention it in passing), which is the near-miss."}

# Added with the 266 -> 349 widening, from packages that widening brought in.
# Written from what each package does rather than from its page: the golden set is
# the instrument, and a question that reuses a page's wording measures the wording.
# The three negatives are absent from the corpus by search, not by assumption -
# 'gantt', 'family tree' and Russia's time zones match no page.
{"question": "Which client library speaks AMQP so a program can publish to RabbitMQ?", "expect_sources": ["pika"], "tags": ["messaging"]}
{"question": "Which package gives Python programs ZeroMQ sockets?", "expect_sources": ["pyzmq"], "tags": ["messaging"]}
{"question": "Which library checks that a telephone number is valid and formats it for a country?", "expect_sources": ["phonenumbers"], "tags": ["validation"]}
{"question": "Where can a program look up the ISO code for a country or a language?", "expect_sources": ["pycountry"], "tags": ["reference-data"]}
{"question": "Which library guesses which natural language a piece of text is written in?", "expect_sources": ["langdetect"], "tags": ["text"]}
{"question": "How can a test run against a real database that is started for it and thrown away afterwards?", "expect_sources": ["testcontainers"], "tags": ["testing"]}
{"question": "How can a traceback be carried from a worker process back to the parent?", "expect_sources": ["tblib"], "tags": ["debugging"]}
{"question": "Which mapping type can be looked up by value as well as by key?", "expect_sources": ["bidict"], "tags": ["data-structures"]}
{"question": "Which library represents a URL as an object whose parts can be replaced?", "expect_sources": ["yarl"], "tags": ["http"]}
{"question": "How can a script drive an interactive command-line program that waits for input?", "expect_sources": ["pexpect"], "tags": ["process"]}
{"question": "How can a process change the name that ps shows for it?", "expect_sources": ["setproctitle"], "tags": ["process"]}
{"question": "Which tool reports how much memory each line of a function uses?", "expect_sources": ["memory-profiler"], "tags": ["profiling"]}
{"question": "Which library spells a number out in words?", "expect_sources": ["num2words"], "tags": ["text"]}
{"question": "Which package pulls the amount and the currency out of a price written as text?", "expect_sources": ["price-parser"], "tags": ["parsing"]}
{"question": "Which YAML parser deliberately refuses the confusing parts of the format?", "expect_sources": ["strictyaml"], "tags": ["serialization"]}
{"question": "Which client writes time-series points into InfluxDB?", "expect_sources": ["influxdb-client"], "tags": ["database"]}
{"question": "Which library records HTTP responses the first time a test runs and replays them afterwards?", "expect_sources": ["vcrpy"], "tags": ["testing"]}
{"question": "Which library scores how similar two strings are when they do not match exactly?", "expect_sources": ["rapidfuzz", "fuzzywuzzy"], "tags": ["text"]}
{"question": "Which library lets shell commands be called as though they were Python functions?", "expect_sources": ["plumbum"], "tags": ["process"]}
{"question": "How can a program find what is still holding a reference to an object that should have been freed?", "expect_sources": ["objgraph"], "tags": ["debugging"]}
{"question": "How can a program tell which Linux distribution it is running on?", "expect_sources": ["distro"], "tags": ["system"]}
{"question": "Which library turns a singular noun into its plural?", "expect_sources": ["inflect"], "tags": ["text"]}
