# Conversation exports are the owner's data, not repository content.
# Drop them in archive/ and index them locally; never commit them.
archive/
!archive/.gitkeep

# Workbench run artifacts: transcripts, judgements and reports are evidence,
# but they are large and regenerable. Committed runs go in provenance/raw/.
.workbench/
runs/

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.data/
*.db
*.db-wal
*.db-shm
.oodarag/
.pytest_cache/
.coverage
htmlcov/
*.log
.DS_Store
